---
import '../styles/global.css';
import '../styles/content.css';
import '../styles/finishing.css';
import '../styles/pixels.css';
import { publicationPath } from '../lib/site';
import { pixelsChapters, pixelsChapterFromPath } from '../lib/pixels';

const {
  title = 'Constraint Grammar of Completed Intelligibility',
  description = 'A periodic generative theory of transformation, completion, and persistence.',
  sourceStatus,
} = Astro.props;

const navItems = [['Wordless','wordless/'],['Pixels','pixels-of-clarity/'],['Theory','theory/'],['Atlas','atlas/'],['54 Forms','forms/'],['Glossary','glossary/'],['Research','research-status/'],['About','about/'],['Rights','rights/']];
const currentPath = Astro.url.pathname;
const isActive = (path: string) => currentPath === publicationPath(path) || currentPath.startsWith(publicationPath(path));
const canonical = new URL(currentPath, Astro.site ?? 'https://titanicparker.github.io');
const socialImage = new URL(publicationPath('social-preview.svg'), Astro.site ?? 'https://titanicparker.github.io');
const rightsPath = publicationPath('rights/');
const showRightsGate = currentPath !== rightsPath && currentPath !== `${rightsPath}index.html`;
const isPixels = currentPath.startsWith(publicationPath('pixels-of-clarity/'));
const pixelsChapter = pixelsChapterFromPath(currentPath);
const pixelsIndex = pixelsChapter ? pixelsChapters.findIndex((item) => item.number === pixelsChapter.number) : -1;
const previousChapter = pixelsIndex > 0 ? pixelsChapters[pixelsIndex - 1] : undefined;
const nextChapter = pixelsIndex >= 0 && pixelsIndex < pixelsChapters.length - 1 ? pixelsChapters[pixelsIndex + 1] : undefined;
const progress = pixelsChapter ? Math.round((pixelsChapter.number / pixelsChapters.length) * 100) : 0;
---
<!doctype html>
<html lang="en" class:list={{ 'cg-rights-locked': showRightsGate }}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={isPixels ? '#f8f5ed' : '#f7f5ef'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={publicationPath('favicon.svg')} type="image/svg+xml" />
    <link rel="stylesheet" href={publicationPath('rights-gate.css')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={isPixels ? 'Pixels of Clarity' : 'Constraint Grammar of Completed Intelligibility'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
  </head>
  <body class:list={{ 'pixels-reader': isPixels }} data-pixels-chapter={pixelsChapter?.number} data-pixels-title={pixelsChapter?.title}>
    {showRightsGate && (
      <section class="cg-rights-gate" id="cg-rights-gate" aria-labelledby="cg-rights-gate-title">
        <div class="cg-rights-gate__panel">
          <p class="cg-rights-gate__eyebrow">Copyright & rights notice</p>
          <h1 id="cg-rights-gate-title">Before entering this publication</h1>
          <p class="cg-rights-gate__copyright">Copyright © 9 August 2026 Liam Moloney. All Rights Reserved.</p>
          <p>This publication is publicly viewable but has not been released under an open-source, Creative Commons, or other general reuse license.</p>
          <p>A limited personal-study permission allows the Portable Knowledge Edition to be downloaded and used as reference material in a GPT or other AI tool for private study and exploration. Broader reproduction, redistribution, adaptation, publication, commercial use, or other reuse requires prior written permission from the copyright holder.</p>
          <p>By selecting the acknowledgement below, you confirm that the copyright and rights status of this publication has been brought to your attention. The acknowledgement itself grants no rights beyond the permission stated on the Rights & Permissions page.</p>
          <div class="cg-rights-gate__actions">
            <button class="cg-rights-gate__button" type="button" data-cg-rights-acknowledge>I acknowledge the Rights & Permissions notice — Enter publication</button>
            <a href={rightsPath}>Read Copyright, Rights & Permissions</a>
          </div>
          <p class="cg-rights-gate__note">Acknowledgement is stored only in this browser and may be requested again if the notice changes.</p>
        </div>
      </section>
    )}
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="site-title" href={isPixels ? publicationPath('pixels-of-clarity/') : publicationPath()}>{isPixels ? 'Pixels of Clarity' : 'Constraint Grammar'}</a>
        <nav class="site-nav" aria-label="Publication">
          {navItems.map(([label,path]) => (<a href={publicationPath(path)} aria-current={isActive(path) ? 'page' : undefined}>{label}</a>))}
        </nav>
      </header>

      {isPixels && (
        <nav class="pixels-bookbar" aria-label="Book navigation">
          <a class="pixels-bookbar__book" href={publicationPath('pixels-of-clarity/')}>Book</a>
          <span class="pixels-bookbar__place">{pixelsChapter ? `Chapter ${pixelsChapter.number} of ${pixelsChapters.length} · ${pixelsChapter.title}` : `${pixelsChapters.length} chapters · complete`}</span>
          {pixelsChapter && <span class="pixels-progress" aria-label={`${progress}% through the book`}><span style={`width:${progress}%`}></span></span>}
        </nav>
      )}

      {sourceStatus && <div class="document-status"><span>{sourceStatus}</span></div>}
      <main id="main-content" tabindex="-1"><slot /></main>

      {pixelsChapter && (
        <nav class="pixels-chapter-nav" aria-label="Chapter navigation">
          {previousChapter ? (
            <a href={publicationPath(`pixels-of-clarity/${previousChapter.path}`)}><small>Previous · Chapter {previousChapter.number}</small><strong>← {previousChapter.title}</strong></a>
          ) : (
            <a href={publicationPath('pixels-of-clarity/')}><small>Book</small><strong>← Chapter list</strong></a>
          )}
          {nextChapter ? (
            <a class="next" href={publicationPath(`pixels-of-clarity/${nextChapter.path}`)}><small>Next · Chapter {nextChapter.number}</small><strong>{nextChapter.title} →</strong></a>
          ) : (
            <a class="next" href={publicationPath('pixels-of-clarity/')}><small>Complete</small><strong>Return to the book →</strong></a>
          )}
        </nav>
      )}

      <footer class="site-footer">
        <p><strong>Copyright © 9 August 2026 Liam Moloney. All Rights Reserved.</strong></p>
        <p>Constraint Grammar of Completed Intelligibility. Source texts remain canonical; interface copy and derived editions are identified by status.</p>
        <nav aria-label="Publication information">
          <a href={publicationPath('wordless/')}>Wordless</a>
          <a href={publicationPath('pixels-of-clarity/')}>Pixels of Clarity</a>
          <a href={publicationPath('constraint-grammar-portable-knowledge-edition.txt')} download>Portable Knowledge Edition (.txt)</a>
          <a href={publicationPath('research-status/')}>Research status</a>
          <a href={publicationPath('about/')}>About & provenance</a>
          <a href={publicationPath('rights/')}>Rights & Permissions</a>
          <a href={publicationPath('search/')}>Search</a>
          <a href="https://github.com/TitanicParker/persistence">Repository</a>
        </nav>
      </footer>
    </div>
    <script src={publicationPath('rights-gate.js')} defer></script>
    {isPixels && <script src={publicationPath('pixels-reader.js')} defer></script>}
  </body>
</html>

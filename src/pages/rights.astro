---
import BaseLayout from '../layouts/BaseLayout.astro';
import { publicationPath } from '../lib/site';
import {
  acknowledgementText,
  copyrightLine,
  personalStudyPermission,
  publicAccessAndReuse,
  rightsLead,
} from '../lib/rights';
---
<BaseLayout
  title="Copyright, Rights & Permissions — Constraint Grammar"
  description="Copyright, rights, personal-study permission, and permissions notice for the Constraint Grammar of Completed Intelligibility publication."
  sourceStatus="Publication rights notice"
>
  <article class="prose rights-page">
    <header>
      <p class="eyebrow">Publication rights</p>
      <h1>Copyright, Rights & Permissions</h1>
      <p class="lede">This page states the copyright and permissions position for the public repository and publication, including the deliberately granted personal-study use of the Portable Knowledge Edition.</p>
    </header>

    <section>
      <p><strong>{copyrightLine}</strong></p>
      {rightsLead.map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <section>
      <h2>Portable Knowledge Edition: personal study permission</h2>
      {personalStudyPermission.map((paragraph) => <p>{paragraph}</p>)}
      <p><a href={publicationPath('constraint-grammar-portable-knowledge-edition.txt')} download>Download the Portable Knowledge Edition (.txt) →</a></p>
    </section>

    <section>
      <h2>Public access and reuse</h2>
      {publicAccessAndReuse.map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <section>
      <h2>Acknowledgement</h2>
      {acknowledgementText.map((paragraph) => <p>{paragraph}</p>)}
      <p><button type="button" class="rights-reset" onclick="localStorage.removeItem('constraint-grammar-rights-acknowledged'); this.textContent='Acknowledgement cleared';">Clear saved acknowledgement</button></p>
    </section>

    <p><a href={publicationPath()}>← Return to the publication</a></p>
  </article>
</BaseLayout>

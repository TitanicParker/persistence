---
import BaseLayout from '../layouts/BaseLayout.astro';
import { publicationPath } from '../lib/site';

const academicRoutes = [
  ['Formal Theory', 'The mature monograph, segmented into durable reading units.', 'theory/'],
  ['Atlas', 'The complete 6 × 3 × 3 coordinate system and its 54 generated positions.', 'atlas/'],
  ['54 Forms', 'Plain-language expositions for every coordinate position.', 'forms/'],
  ['Glossary', 'Preferred terminology, distinctions, relations, and theoretical levels.', 'glossary/'],
  ['Research Status', 'What the project demonstrates internally, what remains hypothetical, and what evidence could weaken it.', 'research-status/'],
  ['Academic Positioning', 'Disciplinary location, limitations, novelty claims, and research programme.', 'academic/'],
  ['Intellectual History', 'How the theory developed from sentence resolution toward constraint grammar.', 'history/'],
  ['About & Provenance', 'Source hierarchy, publication version, repository, and citation guidance.', 'about/'],
  ['Search', 'Find theory chapters, atlas cells, forms, glossary terms, and supporting essay headings.', 'search/'],
];

const expositionEssays = [
  ['Layman’s Edition', 'A serious plain-language explanation of the framework for readers who do not want to begin with formal theory.', 'layman/', 'Derived explanatory essay'],
  ['Venture Edition', 'A strategic reading of what capabilities, products, and companies might become possible if the framework proves useful.', 'venture/', 'Derived strategic interpretation'],
  ['If We Learned to See Completion', 'A broader consequences essay about what changes if completion becomes something we can recognize systematically.', 'mainstream/', 'Derived consequences essay'],
];
---
<BaseLayout description="A static digital publication of the Constraint Grammar of Completed Intelligibility, with simple explanations, a portable study edition, formal theory, a 54-cell atlas, explanatory forms, glossary, research status, and derived essays." sourceStatus="Publication entrance · editorial framing">
  <div class="page home-page">
    <aside class="homepage-rights-notice" aria-label="Copyright and rights status"><span>Copyright © 9 August 2026 Liam Moloney. All Rights Reserved.</span><a href={publicationPath('rights/')}>Rights & Permissions →</a></aside>

    <section class="hero home-hero">
      <p class="eyebrow">Constraint Grammar of Completed Intelligibility</p>
      <h1>How does something become complete enough to count?</h1>
      <p class="lede">Begin with the idea in ordinary language, take the entire publication away as a study object, or move into the formal academic layer when you are ready.</p>
    </section>

    <section class="entrance-section" aria-labelledby="start-simple">
      <header class="entrance-heading"><p class="eyebrow">Start with the idea</p><h2 id="start-simple">Two simple ways in.</h2></header>
      <div class="entrance-grid">
        <a class="entrance-card" href={publicationPath('layman/')}><span class="edition-label">Layman’s Edition</span><h3>Understand it in plain language</h3><p>A serious non-specialist route through what the framework is trying to explain, why completion matters, and how the 54-position architecture fits together.</p><span class="entrance-action">Read the Layman’s Edition →</span></a>
        <a class="entrance-card" href={publicationPath('five-year-old/')}><span class="edition-label">Five-Year-Old Edition</span><h3>Reduce it to the smallest questions</h3><p>The whole theory approached through three simple questions: what changed, what made that change enough, and what is left afterward?</p><span class="entrance-action">Read the Five-Year-Old Edition →</span></a>
      </div>
    </section>

    <section class="section portable-knowledge-section" aria-labelledby="portable-knowledge-title">
      <div class="section-intro"><div><p class="eyebrow">Study and test it your own way</p><h2 id="portable-knowledge-title">Take the entire publication to a GPT.</h2></div><div>
        <p>The Portable Knowledge Edition is one plain-text file containing the principal sources, the Five-Year-Old and Layman editions, source-status markers, research context, and the longer derived essays.</p>
        <p>Download it, upload it to a GPT or another AI tool as reference material, and question, test, compare, or explore the work in whatever sequence helps you understand it. The TXT carries the copyright and permissions notice with it.</p>
        <p><a class="entrance-action" href={publicationPath('constraint-grammar-portable-knowledge-edition.txt')} download>Download the entire publication (.txt) →</a></p>
        <p><a href={publicationPath('rights/')}>Read the personal-study permission and Rights & Permissions →</a></p>
      </div></div>
    </section>

    <section class="section architecture-section" aria-labelledby="academic-layer-title">
      <div class="section-intro"><div><p class="eyebrow">Academic layer</p><h2 id="academic-layer-title">Enter the formal publication.</h2></div><p>The academic layer contains the mature monograph, structural Atlas, fifty-four Forms, authoritative Glossary, research-status boundary, disciplinary positioning, intellectual history, provenance, and search.</p></div>
      <div class="architecture" aria-label="Constraint grammar architecture"><div><strong>6</strong><span>Transformation Patterns</span></div><div><strong>3</strong><span>Completion Topologies</span></div><div><strong>3</strong><span>Persistence Modes</span></div></div>
      <div class="route-grid compact-route-grid">{academicRoutes.map(([title, body, path]) => (<a class="route-card" href={publicationPath(path)}><h3>{title}</h3><p>{body}</p></a>))}</div>
    </section>

    <section class="section" aria-labelledby="exposition-essays-title">
      <div class="section-intro"><div><p class="eyebrow">Exposition and interpretation</p><h2 id="exposition-essays-title">Three longer essays.</h2></div><p>These are derived readings of the same framework. They are ways of explaining, interpreting, or extending the implications of the canonical theory rather than replacements for it.</p></div>
      <div class="route-grid">{expositionEssays.map(([title, body, path, status]) => (<a class="route-card" href={publicationPath(path)}><span class="edition-label">{status}</span><h3>{title}</h3><p>{body}</p></a>))}</div>
    </section>
  </div>
</BaseLayout>

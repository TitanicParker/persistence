---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { parseGlossary } from '../../lib/content/glossary';
export function getStaticPaths() { return parseGlossary().map((term) => ({ params: { slug: term.slug }, props: { term } })); }
const { term } = Astro.props;
---
<BaseLayout title={`${term.term} — Glossary`}>
  <article class="prose glossary-entry"><header><p class="eyebrow">{term.category}</p><h1>{term.term}</h1><p class="lede">Preferred status: {term.preferredStatus}</p></header>
    <dl class="glossary-definition"><dt>Definition</dt><dd>{term.definition}</dd><dt>Function in the theory</dt><dd>{term.functionInTheory}</dd><dt>Distinguish from</dt><dd>{term.distinguishFrom}</dd><dt>Relations</dt><dd>{term.relationsRaw}</dd></dl>
    <p><a href="/glossary/">← Glossary index</a></p>
  </article>
</BaseLayout>

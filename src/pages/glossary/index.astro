---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { parseGlossary } from '../../lib/content/glossary';
const terms = parseGlossary();
const grouped = Object.entries(Object.groupBy(terms, (term) => term.category));
---
<BaseLayout title="Glossary — Constraint Grammar">
  <article class="reading-index"><header><p class="eyebrow">Terminological reference</p><h1>Glossary</h1><p class="lede">Canonical terms parsed from the exhaustive glossary, preserving preferred status and theoretical section.</p></header>
    <nav class="alphabet" aria-label="Alphabetical glossary index">{[...new Set(terms.map((term) => term.term[0]?.toUpperCase()))].map((letter) => <a href={`#letter-${letter}`}>{letter}</a>)}</nav>
    {grouped.map(([category, categoryTerms]) => <section><h2>{category}</h2><dl>{categoryTerms!.map((term) => <><dt id={`letter-${term.term[0]?.toUpperCase()}`}><a href={`/glossary/${term.slug}/`}>{term.term}</a></dt><dd>{term.definition}</dd></>)}</dl></section>)}
  </article>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { publicationPath } from '../lib/site';
import { pixelsChapters } from '../lib/pixels';
---
<BaseLayout title="Pixels of Clarity" description="A complete eighteen-chapter discovery-based introduction to structureacy for young readers and the adults learning alongside them." sourceStatus="Pedagogical edition · complete · 18 chapters">
  <article class="book-home">
    <header class="hero">
      <p class="eyebrow">A discovery book for curious readers</p>
      <h1>Pixels of Clarity</h1>
      <p class="lede">A class begins with a bag of ordinary sentences. By sorting, comparing, arguing, testing, and wondering, they gradually discover the structure hidden in things they already understand.</p>
      <div class="book-actions">
        <a class="start-button" href={publicationPath('pixels-of-clarity/chapter-01/')}>Start reading →</a>
        <a class="continue-button" data-pixels-continue hidden href={publicationPath('pixels-of-clarity/chapter-01/')}>Continue reading</a>
      </div>
      <p class="quiet-note">No special vocabulary needed at the start. The formal map arrives only after you have earned it.</p>
    </header>

    <section aria-labelledby="chapter-list-title">
      <div class="section-heading">
        <div><p class="eyebrow">The journey</p><h2 id="chapter-list-title">Read the book</h2></div>
        <p>Each chapter sharpens one question before introducing the next. Discovery comes before terminology, and difficult cases stay visible rather than being tidied away.</p>
      </div>
      <ol class="chapters">
        {pixelsChapters.map((chapter) => (
          <li>
            <a href={publicationPath(`pixels-of-clarity/${chapter.path}`)}>
              <span class="number">{chapter.label}</span>
              <span class="chapter-copy"><strong>{chapter.title}</strong><small>{chapter.note}</small></span>
              <span class="read">Read →</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="adult-paths" aria-labelledby="alongside-title">
      <p class="eyebrow">Reading alongside a child?</p>
      <h2 id="alongside-title">The book stays in front.</h2>
      <p>Teachers, researchers, and adults who want the formal apparatus can move into the wider publication when it becomes useful. A young reader never needs those sections in order to continue the story.</p>
      <p><a href={publicationPath('about/')}>About the project</a> · <a href={publicationPath('theory/')}>Explore the structure</a> · <a href={publicationPath('atlas/')}>Open the atlas</a></p>
    </section>
  </article>
</BaseLayout>

<style>
.book-home{width:min(calc(100% - 2rem),58rem);margin:0 auto;padding:0 0 6rem}.hero{padding:clamp(3.5rem,9vw,7rem) 0 4rem}.hero h1{max-width:12ch;font-size:clamp(3.5rem,11vw,7.5rem);line-height:.88;letter-spacing:-.06em;margin:.3rem 0 1.4rem}.lede{max-width:45rem;font-size:clamp(1.18rem,2vw,1.5rem);line-height:1.55}.book-actions{display:flex;flex-wrap:wrap;gap:.75rem;margin:2rem 0 1.2rem}.book-actions a{min-height:3.25rem;display:inline-flex;align-items:center;padding:.75rem 1rem;border:1px solid var(--ink);text-decoration:none;font:700 .95rem/1.2 system-ui,sans-serif}.start-button{background:var(--ink);color:var(--paper)}.continue-button{border-color:var(--accent)!important;color:var(--accent)}.quiet-note{max-width:42rem;color:var(--muted);font-size:.95rem;line-height:1.55}.book-home section{border-top:1px solid var(--rule);padding:3rem 0}.section-heading{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1fr);gap:2rem;align-items:start}.section-heading h2,.adult-paths h2{font-size:clamp(2rem,5vw,3.4rem);letter-spacing:-.04em}.section-heading>p,.adult-paths>p{margin-top:0;line-height:1.65}.chapters{list-style:none;padding:0;margin:2rem 0 0;border-top:1px solid var(--rule)}.chapters a{display:grid;grid-template-columns:3rem minmax(0,1fr) auto;gap:1rem;align-items:center;min-height:4.75rem;padding:1rem 0;border-bottom:1px solid var(--rule);color:inherit;text-decoration:none}.chapter-copy{display:grid;gap:.28rem}.chapter-copy strong{font-size:1.08rem}.chapter-copy small{color:var(--muted);font:400 .88rem/1.45 system-ui,sans-serif}.number{font:800 .73rem/1 system-ui,sans-serif;color:var(--muted);letter-spacing:.08em}.read{font:700 .8rem/1 system-ui,sans-serif}.adult-paths{max-width:48rem}.adult-paths a{font-weight:600}@media(max-width:620px){.book-home{width:min(calc(100% - 1.5rem),58rem)}.hero{padding-top:3rem}.section-heading{grid-template-columns:1fr;gap:.5rem}.chapters a{grid-template-columns:2.35rem 1fr;align-items:start;padding:1rem 0}.read{display:none}.book-actions{display:grid}.book-actions a{justify-content:center}.chapter-copy strong{line-height:1.25}}
</style>

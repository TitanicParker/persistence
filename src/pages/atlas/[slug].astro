---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { parseAtlas } from '../../lib/content/atlas';
import { publicationPath } from '../../lib/site';
export function getStaticPaths() {
  const cells = parseAtlas();
  return cells.map((cell, index) => ({
    params: { slug: cell.slug },
    props: {
      cell,
      previous: index > 0 ? cells[index - 1] : null,
      next: index < cells.length - 1 ? cells[index + 1] : null,
    },
  }));
}
const { cell, previous, next } = Astro.props;
---
<BaseLayout title={`${cell.canonicalCrystallization} — Atlas`}>
  <article class="prose atlas-cell">
    <header><p class="eyebrow">Atlas · Cell {cell.number} of 54 · {cell.transformationPattern} / {cell.completionTopology} / {cell.persistenceMode}</p><h1>{cell.canonicalCrystallization}</h1><p class="lede">{cell.coordinateGeneratedForm}</p></header>
    <p class="index-crosslink"><a href={publicationPath('atlas/')}>← Atlas overview</a> · <a href={publicationPath(`forms/${cell.slug}/`)}>Plain-language exposition</a></p>
    <dl class="metadata"><dt>Companion utterance</dt><dd>{cell.companionUtterance}</dd><dt>Constraint strength</dt><dd>{cell.constraintStrength}</dd><dt>Generative movement</dt><dd>{cell.generativeMovement}</dd></dl>
    <section><h2>Coordinate-forced sentence</h2><p>{cell.coordinateForcedSentence}</p></section>
    <section><h2>Manifestations</h2><ol>{cell.examples.map((example) => <li>{example}</li>)}</ol></section>
    <nav class="reader-nav" aria-label="Atlas cell navigation">
      {previous ? <a rel="prev" href={publicationPath(`atlas/${previous.slug}/`)}>← {String(previous.number).padStart(2,'0')} {previous.canonicalCrystallization}</a> : <span />}
      <a href={publicationPath('atlas/')}>All 54 cells</a>
      {next ? <a rel="next" href={publicationPath(`atlas/${next.slug}/`)}>{String(next.number).padStart(2,'0')} {next.canonicalCrystallization} →</a> : <span />}
    </nav>
  </article>
</BaseLayout>
